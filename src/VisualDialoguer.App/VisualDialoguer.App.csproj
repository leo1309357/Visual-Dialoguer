<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VisualDialoguer.App</RootNamespace>
    <AssemblyName>VisualDialoguer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 单机可执行：不做 MSIX 打包，Windows App SDK 运行时随程序走，
         免去签名与安装步骤。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <!-- Portable 单文件发布：所有托管与原生依赖（含 .NET 运行时、
         Windows App SDK 引导器与 WinUI XAML 原生库）全部自解压进单个
         VisualDialoguer.exe，拷到目标机即可运行，无需预装任何运行时。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 只保留中文（zh-CN）卫星资源，去掉几十种语言目录，显著减小体积。 -->
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualDialoguer.Core\VisualDialoguer.Core.csproj" />
    <ProjectReference Include="..\Loma.Theme\Loma.Theme.csproj" />
  </ItemGroup>

  <!-- 帮助文档:由 tools/build_docs.py 生成(同一份 HTML 也是静态站产物),
       以嵌入资源打进程序集,运行时由帮助面板读取并内嵌浏览。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Docs\cdlg-docs.html" />
  </ItemGroup>

</Project>

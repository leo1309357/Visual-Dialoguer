<?xml version="1.0" encoding="utf-8"?>
<!--
  统一工作台 ·「Loma」轻拟物

  三栏布局：左节点栏 | 中指令流 | 右属性面板。
  所有面板都是 LomaCard 凸起面，靠双向阴影分层。
  流程图作为覆盖层浮在最上方。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid Padding="12,8,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- ════════ 左栏：节点列表 ════════ -->
        <ContentControl Grid.Column="0" Style="{StaticResource LomaCard}">
            <Grid
                Padding="{StaticResource LomaPadCard}"
                RowSpacing="8"
                RowDefinitions="Auto,Auto,*,Auto">

                <TextBlock Text="节点" Style="{StaticResource LomaSectionTitle}" />

                <!-- 节点搜索框 -->
                <TextBox
                    Grid.Row="1"
                    x:Name="NodeSearch"
                    PlaceholderText="筛选节点…"
                    GotFocus="OnSearchGotFocus"
                    LostFocus="OnSearchLostFocus"
                    TextChanged="OnNodeSearchTextChanged" />

                <ListView
                    Grid.Row="2"
                    x:Name="NodeList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource LomaNodeRow}"
                    SelectionChanged="OnNodeSelectionChanged"
                    DoubleTapped="OnNodeDoubleTapped" />

                <Grid Grid.Row="3" ColumnSpacing="{StaticResource LomaSpaceS}" ColumnDefinitions="Auto,Auto,Auto">
                    <Button
                        Content="＋"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnAddNode"
                        ToolTipService.ToolTip="新建节点" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnDeleteNode"
                        ToolTipService.ToolTip="删除选中节点">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnSetEntry"
                        ToolTipService.ToolTip="设为入口 ★">
                        <FontIcon Glyph="&#xE734;" />
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ════════ 中栏：指令流 ════════ -->
        <ContentControl Grid.Column="1" Style="{StaticResource LomaCard}">
            <Grid
                Padding="{StaticResource LomaPadCard}"
                RowSpacing="{StaticResource LomaSpaceS}"
                RowDefinitions="Auto,Auto,*,Auto,Auto">

                <Grid ColumnSpacing="{StaticResource LomaSpaceS}" ColumnDefinitions="Auto,*">
                    <TextBlock
                        x:Name="CurrentNodeLabel"
                        Text="未选择节点"
                        Style="{StaticResource LomaSectionTitle}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        x:Name="KindPicker"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        UseSystemFocusVisuals="False"
                        Header="新增类型" />
                </Grid>

                <!-- 搜索框独立一行，全宽 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <TextBox
                        x:Name="InstructionSearch"
                        PlaceholderText="搜索指令内容…"
                        GotFocus="OnSearchGotFocus"
                        LostFocus="OnSearchLostFocus"
                        TextChanged="OnInstructionSearchTextChanged" />
                    <Button
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnInstructionSearchClear"
                        ToolTipService.ToolTip="清除搜索">
                        <SymbolIcon Symbol="Clear" />
                    </Button>
                </Grid>

                <!-- 指令类型筛选标签栏 -->
                <StackPanel
                    Grid.Row="2"
                    x:Name="FilterBar"
                    Orientation="Horizontal"
                    Spacing="6" />

                <ListView
                    Grid.Row="3"
                    x:Name="InstructionList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource LomaInstructionRow}"
                    SelectionChanged="OnInstructionSelectionChanged" />

                <Grid Grid.Row="4" ColumnSpacing="{StaticResource LomaSpaceS}" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                    <Button
                        Content="新增指令"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnAddInstruction" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnDeleteInstruction"
                        ToolTipService.ToolTip="删除选中指令">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnMoveUp"
                        ToolTipService.ToolTip="上移">
                        <SymbolIcon Symbol="Up" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnMoveDown"
                        ToolTipService.ToolTip="下移">
                        <FontIcon Glyph="&#xE74B;" />
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ════════ 右栏：属性面板 ════════ -->
        <ContentControl Grid.Column="2" Style="{StaticResource LomaCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource LomaPadCard}">
                <local:InstructionEditorPanel x:Name="Editor" />
            </ScrollViewer>
        </ContentControl>
    </Grid>
</local:EditorPageBase>

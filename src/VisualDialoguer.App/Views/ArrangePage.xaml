<?xml version="1.0" encoding="utf-8"?>
<!--
  「指令编排」页 ·「稿台 Paperstage」

  与「对话结构」同一套纸片语言，只是节点选择收成顶部一道下拉框，
  把宽度让给指令表——集中编排一个节点时用。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.ArrangePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid
        Padding="{StaticResource PsPadCard}"
        ColumnSpacing="{StaticResource PsSpaceL}"
        ColumnDefinitions="*,324">

        <ContentControl Grid.Column="0" Style="{StaticResource PsCard}">
            <Grid
                Padding="{StaticResource PsPadCard}"
                RowSpacing="{StaticResource PsSpaceM}"
                RowDefinitions="Auto,*,Auto">

                <!-- 节点选择：案头顶部的一枚标签。"设为入口"作用于节点而非
                     指令，跟在下拉框后面，指令动作行就能与结构页完全一致。 -->
                <Grid ColumnSpacing="{StaticResource PsSpaceM}" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock
                        Text="节点"
                        Style="{StaticResource PsSectionTitle}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        x:Name="NodePicker"
                        HorizontalAlignment="Left"
                        MinWidth="240"
                        SelectionChanged="OnNodePicked" />
                    <Button
                        Grid.Column="2"
                        Content="设为入口"
                        Click="OnSetEntry" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    x:Name="InstructionList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource PsInstructionRow}"
                    SelectionChanged="OnInstructionSelectionChanged" />

                <!-- 与结构页同一套排布：类型一行、动作一行 -->
                <Grid Grid.Row="2" RowSpacing="{StaticResource PsSpaceM}" RowDefinitions="Auto,Auto">
                    <ComboBox
                        x:Name="KindPicker"
                        Header="类型"
                        HorizontalAlignment="Stretch" />
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource PsSpaceS}">
                        <Button
                            Content="新增指令"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnAddInstruction" />
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnDeleteInstruction"
                            ToolTipService.ToolTip="删除选中指令">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnMoveUp"
                            ToolTipService.ToolTip="上移">
                            <SymbolIcon Symbol="Up" />
                        </Button>
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnMoveDown"
                            ToolTipService.ToolTip="下移">
                            <!-- Symbol 枚举没有下箭头，用 Segoe Fluent Icons 字形 -->
                            <FontIcon Glyph="&#xE74B;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 属性面板 -->
        <ContentControl Grid.Column="1" Style="{StaticResource PsCard}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Padding="{StaticResource PsPadCard}">
                <local:InstructionEditorPanel x:Name="Editor" />
            </ScrollViewer>
        </ContentControl>
    </Grid>
</local:EditorPageBase>

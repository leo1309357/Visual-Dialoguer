<?xml version="1.0" encoding="utf-8"?>
<!--
  「指令编排」页 ·「Loma」轻拟物

  与「对话结构」同一套凸起面语言，节点选择收成顶部一道下拉框，
  把宽度让给指令表。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.ArrangePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid
        Padding="{StaticResource LomaPadCard}"
        ColumnSpacing="{StaticResource LomaSpaceL}"
        ColumnDefinitions="*,324">

        <ContentControl Grid.Column="0" Style="{StaticResource LomaCard}">
            <Grid
                Padding="{StaticResource LomaPadCard}"
                RowSpacing="{StaticResource LomaSpaceM}"
                RowDefinitions="Auto,*,Auto">

                <Grid ColumnSpacing="{StaticResource LomaSpaceM}" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock
                        Text="节点"
                        Style="{StaticResource LomaSectionTitle}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        x:Name="NodePicker"
                        HorizontalAlignment="Left"
                        MinWidth="240"
                        UseSystemFocusVisuals="False"
                        SelectionChanged="OnNodePicked" />
                    <Button
                        Grid.Column="2"
                        Content="设为入口"
                        Click="OnSetEntry" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    x:Name="InstructionList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource LomaInstructionRow}"
                    SelectionChanged="OnInstructionSelectionChanged" />

                <Grid Grid.Row="2" RowSpacing="{StaticResource LomaSpaceM}" RowDefinitions="Auto,Auto">
                    <ComboBox
                        x:Name="KindPicker"
                        Header="类型"
                        HorizontalAlignment="Stretch"
                        UseSystemFocusVisuals="False" />
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource LomaSpaceS}">
                        <Button
                            Content="新增指令"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnAddInstruction" />
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnDeleteInstruction"
                            ToolTipService.ToolTip="删除选中指令">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnMoveUp"
                            ToolTipService.ToolTip="上移">
                            <SymbolIcon Symbol="Up" />
                        </Button>
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnMoveDown"
                            ToolTipService.ToolTip="下移">
                            <FontIcon Glyph="&#xE74B;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 属性面板 -->
        <ContentControl Grid.Column="1" Style="{StaticResource LomaCard}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Padding="{StaticResource LomaPadCard}">
                <local:InstructionEditorPanel x:Name="Editor" />
            </ScrollViewer>
        </ContentControl>
    </Grid>
</local:EditorPageBase>

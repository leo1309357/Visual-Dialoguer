<?xml version="1.0" encoding="utf-8"?>
<!--
  「流程图」页 ·「Loma」轻拟物

  案垫是一块带网格的桌面(LomaGraphDesk/LomaGraphGrid)，节点是浮起的索引卡。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.GraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid RowDefinitions="Auto,*">
        <ContentControl
            Grid.Row="0"
            Margin="12,10,12,0"
            Padding="{StaticResource LomaPadBanner}"
            Style="{StaticResource LomaCard}">
            <TextBlock
                Text="流程图 · 节点按顺序排在网格上，choice / goto 画出牵线。点节点框跳回「对话结构」。"
                Style="{StaticResource LomaCaption}" />
        </ContentControl>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Padding="{StaticResource LomaPadCard}">
            <Canvas
                x:Name="GraphCanvas"
                MinWidth="800"
                MinHeight="480" />
        </ScrollViewer>
    </Grid>
</local:EditorPageBase>

<?xml version="1.0" encoding="utf-8"?>
<!--
  指令属性面板 ·「Loma」轻拟物

  井口式设计：字段区整体下沉一层(LomaWell)，输入框嵌在里面，
  聚焦时浮起一圈 accent 色。
-->
<UserControl
    x:Class="VisualDialoguer.App.Views.InstructionEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="{StaticResource LomaSpaceM}">
        <TextBlock Text="属性" Style="{StaticResource LomaSectionTitle}" />

        <ComboBox
            x:Name="TypeBox"
            Header="类型"
            HorizontalAlignment="Stretch"
            UseSystemFocusVisuals="False"
            SelectionChanged="OnTypeChanged" />

        <ContentControl x:Name="WellHost" Style="{StaticResource LomaWell}">
            <StackPanel
                x:Name="FieldsHost"
                Spacing="{StaticResource LomaSpaceM}"
                Padding="10" />
        </ContentControl>

        <TextBlock
            x:Name="EmptyHint"
            Text="未选中指令。选中一条指令后在这里改它的字段。"
            Style="{StaticResource LomaCaption}"
            Foreground="{ThemeResource LomaInkTertiary}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>

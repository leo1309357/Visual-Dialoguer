<?xml version="1.0" encoding="utf-8"?>
<!--
  「对话结构」页 ·「Loma」轻拟物

  三块凸起面并排：节点表、指令表、属性面板。卡片统一用 LomaCard 底座
  （双向阴影 + 顶受光渐变），不靠描边就有厚度。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.StructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid
        Padding="{StaticResource LomaPadCard}"
        ColumnSpacing="{StaticResource LomaSpaceL}"
        ColumnDefinitions="232,*,324">

        <!-- 节点表 -->
        <ContentControl Grid.Column="0" Style="{StaticResource LomaCard}">
            <Grid
                Padding="{StaticResource LomaPadCard}"
                RowSpacing="{StaticResource LomaSpaceM}"
                RowDefinitions="Auto,*,Auto">
                <TextBlock Text="节点" Style="{StaticResource LomaSectionTitle}" />

                <ListView
                    Grid.Row="1"
                    x:Name="NodeList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource LomaNodeRow}"
                    SelectionChanged="OnNodeSelectionChanged" />

                <Grid Grid.Row="2" ColumnSpacing="{StaticResource LomaSpaceS}" ColumnDefinitions="Auto,Auto,*">
                    <Button
                        Content="新增节点"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnAddNode" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnDeleteNode"
                        ToolTipService.ToolTip="删除选中节点">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LomaIconButton}"
                        Click="OnSetEntry"
                        ToolTipService.ToolTip="把选中节点设为入口（★）">
                        <FontIcon Glyph="&#xE734;" />
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 当前节点的指令表 -->
        <ContentControl Grid.Column="1" Style="{StaticResource LomaCard}">
            <Grid
                Padding="{StaticResource LomaPadCard}"
                RowSpacing="{StaticResource LomaSpaceM}"
                RowDefinitions="Auto,*,Auto">
                <TextBlock Text="指令" Style="{StaticResource LomaSectionTitle}" />

                <ListView
                    Grid.Row="1"
                    x:Name="InstructionList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource LomaInstructionRow}"
                    SelectionChanged="OnInstructionSelectionChanged" />

                <Grid Grid.Row="2" RowSpacing="{StaticResource LomaSpaceM}" RowDefinitions="Auto,Auto">
                    <ComboBox
                        x:Name="KindPicker"
                        Header="类型"
                        HorizontalAlignment="Stretch"
                        UseSystemFocusVisuals="False" />
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource LomaSpaceS}">
                        <Button
                            Content="新增指令"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnAddInstruction" />
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnDeleteInstruction"
                            ToolTipService.ToolTip="删除选中指令">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnMoveUp"
                            ToolTipService.ToolTip="上移">
                            <SymbolIcon Symbol="Up" />
                        </Button>
                        <Button
                            Style="{StaticResource LomaIconButton}"
                            Click="OnMoveDown"
                            ToolTipService.ToolTip="下移">
                            <FontIcon Glyph="&#xE74B;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 属性面板 -->
        <ContentControl Grid.Column="2" Style="{StaticResource LomaCard}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Padding="{StaticResource LomaPadCard}">
                <local:InstructionEditorPanel x:Name="Editor" />
            </ScrollViewer>
        </ContentControl>
    </Grid>
</local:EditorPageBase>

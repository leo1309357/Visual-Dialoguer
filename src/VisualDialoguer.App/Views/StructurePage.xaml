<?xml version="1.0" encoding="utf-8"?>
<!--
  「对话结构」页 ·「稿台 Paperstage」

  三张纸片并排：节点表、指令表、属性面板。卡片统一用 PsCard 底座
  （环境影 + 关键影 + 顶缘高光 + 发丝边），不用重投影就有厚度。
-->
<local:EditorPageBase
    x:Class="VisualDialoguer.App.Views.StructurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid
        Padding="{StaticResource PsPadCard}"
        ColumnSpacing="{StaticResource PsSpaceL}"
        ColumnDefinitions="232,*,324">

        <!-- 节点表 -->
        <ContentControl Grid.Column="0" Style="{StaticResource PsCard}">
            <Grid
                Padding="{StaticResource PsPadCard}"
                RowSpacing="{StaticResource PsSpaceM}"
                RowDefinitions="Auto,*,Auto">
                <TextBlock Text="节点" Style="{StaticResource PsSectionTitle}" />

                <ListView
                    Grid.Row="1"
                    x:Name="NodeList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource PsNodeRow}"
                    SelectionChanged="OnNodeSelectionChanged" />

                <!-- 主操作给强调色；删除与设入口收成图标钮：232 宽放不下
                     三个文字按钮，图标 + 提示语既省地方又不挤。 -->
                <Grid Grid.Row="2" ColumnSpacing="{StaticResource PsSpaceS}" ColumnDefinitions="Auto,Auto,*">
                    <Button
                        Content="新增节点"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnAddNode" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource PsIconButton}"
                        Click="OnDeleteNode"
                        ToolTipService.ToolTip="删除选中节点">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PsIconButton}"
                        Click="OnSetEntry"
                        ToolTipService.ToolTip="把选中节点设为入口（★）">
                        <FontIcon Glyph="&#xE734;" />
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 当前节点的指令表 -->
        <ContentControl Grid.Column="1" Style="{StaticResource PsCard}">
            <Grid
                Padding="{StaticResource PsPadCard}"
                RowSpacing="{StaticResource PsSpaceM}"
                RowDefinitions="Auto,*,Auto">
                <TextBlock Text="指令" Style="{StaticResource PsSectionTitle}" />

                <ListView
                    Grid.Row="1"
                    x:Name="InstructionList"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource PsInstructionRow}"
                    SelectionChanged="OnInstructionSelectionChanged" />

                <!-- 类型与按钮分两行：296 宽的卡里，"类型"下拉 + 四个按钮
                     横排会溢出被裁掉（原先靠横向滚动勉强看全）。 -->
                <Grid Grid.Row="2" RowSpacing="{StaticResource PsSpaceM}" RowDefinitions="Auto,Auto">
                    <ComboBox
                        x:Name="KindPicker"
                        Header="类型"
                        HorizontalAlignment="Stretch" />
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource PsSpaceS}">
                        <Button
                            Content="新增指令"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnAddInstruction" />
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnDeleteInstruction"
                            ToolTipService.ToolTip="删除选中指令">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnMoveUp"
                            ToolTipService.ToolTip="上移">
                            <SymbolIcon Symbol="Up" />
                        </Button>
                        <Button
                            Style="{StaticResource PsIconButton}"
                            Click="OnMoveDown"
                            ToolTipService.ToolTip="下移">
                            <!-- Symbol 枚举没有下箭头，用 Segoe Fluent Icons 字形 -->
                            <FontIcon Glyph="&#xE74B;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- 属性面板 -->
        <ContentControl Grid.Column="2" Style="{StaticResource PsCard}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Padding="{StaticResource PsPadCard}">
                <local:InstructionEditorPanel x:Name="Editor" />
            </ScrollViewer>
        </ContentControl>
    </Grid>
</local:EditorPageBase>

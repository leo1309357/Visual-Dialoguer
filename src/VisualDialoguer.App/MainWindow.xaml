<?xml version="1.0" encoding="utf-8"?>
<!--
  主窗口外壳 ·「稿台 Paperstage」

  层次自下而上：案垫(PsDesk) → 命令栏与页签各自是一张稿纸(PsPaper) →
  内容卡片再浮起一层。状态栏做成"案头信息条"，压在最底下。
-->
<Window
    x:Class="VisualDialoguer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualDialoguer.App.Views">

    <Grid Background="{ThemeResource PsDesk}" RowDefinitions="Auto,*,Auto">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAcceleratorNew" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnAcceleratorOpen" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnAcceleratorSave" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnAcceleratorSaveAs" />
            <KeyboardAccelerator Key="F5" Invoked="OnAcceleratorValidate" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnAcceleratorUndo" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnAcceleratorRedo" />
        </Grid.KeyboardAccelerators>

        <!-- 命令栏：一张浮起的稿纸，底部一道发丝边把它和内容分开 -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource PsCardFace}"
            BorderBrush="{ThemeResource PsEdge}"
            BorderThickness="0,0,0,1">
            <CommandBar
                x:Name="Toolbar"
                DefaultLabelPosition="Right"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0">
                <AppBarButton Label="新建" Click="OnNew">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Page" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="打开" Click="OnOpen">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="保存" Click="OnSave">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="另存为" Click="OnSaveAs">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="校验" Click="OnValidate">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="撤销" Click="OnUndo">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Undo" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="重做" Click="OnRedo">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Redo" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Border>

        <!-- 页签区：选中的页签本身就是浮起的稿纸，未选中是案垫上的压痕 -->
        <TabView
            Grid.Row="1"
            x:Name="Tabs"
            Background="Transparent"
            Padding="8,8,8,0"
            IsAddTabButtonVisible="False">
            <TabViewItem Header="对话结构" IsClosable="False"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                <local:StructurePage x:Name="StructurePage" />
            </TabViewItem>
            <TabViewItem Header="指令编排" IsClosable="False"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                <local:ArrangePage x:Name="ArrangePage" />
            </TabViewItem>
            <TabViewItem Header="流程图" IsClosable="False"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                <local:GraphPage x:Name="GraphPage" />
            </TabViewItem>
        </TabView>

        <!-- 案头信息条 -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource PsPaper}"
            BorderBrush="{ThemeResource PsEdge}"
            BorderThickness="0,1,0,0"
            Padding="{StaticResource PsPadStatusBar}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource PsCaption}"
                    Text="就绪。" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="CountsText"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource PsFontSizeCaption}"
                    Foreground="{ThemeResource PsInkTertiary}" />
            </Grid>
        </Border>
    </Grid>
</Window>

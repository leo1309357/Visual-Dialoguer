<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与主应用同 TFM / 同 Windows App SDK 版本，确保编译与打包一致。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Loma.Theme</RootNamespace>
    <AssemblyName>Loma.Theme</AssemblyName>

    <!-- 跟随主应用的单 RID 策略（win-x64 自包含单文件）。 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
  </ItemGroup>

</Project>

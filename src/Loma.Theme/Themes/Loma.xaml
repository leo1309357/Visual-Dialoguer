    <!-- ═══════════ 组件样式 ═══════════ -->

    <!-- 卡片标题 -->
    <Style x:Key="LomaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LomaFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInk}" />
    </Style>

    <!-- 次要说明文字 -->
    <Style x:Key="LomaCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LomaFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInkSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      LomaRaised：凸起卡片。整个界面的基础单元。

      轻拟物的核心技法——用四层叠出"从桌面上凸起来"的质感：
        ① 右下暗投影（最底层）：比卡面大一圈，偏移右下，给出厚度；
        ② 左上亮高光（第二层）：比卡面小一圈，偏移左上，模拟受光；
        ③ 卡面本身：顶部受光渐变，与底色几乎同色；
        ④ 内容层。

      因为没有边框线，立体感完全靠这两层偏移的半透明色块撑出来。
      光源统一来自左上，所有凸起物共用同一套光影方向。
    -->
    <Style x:Key="LomaCard" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- 外层环境影：大而淡，向四周铺开 -->
                        <Border
                            Margin="4,8,-4,-8"
                            Background="{ThemeResource LomaShadowAmbient}"
                            CornerRadius="{StaticResource LomaCardRadius}"
                            IsHitTestVisible="False" />
                        <!-- 内层接触影：贴边偏右下，给出厚度 -->
                        <Border
                            Margin="2,3,-2,-3"
                            Background="{ThemeResource LomaShadowDarkDeep}"
                            CornerRadius="{StaticResource LomaCardRadius}"
                            IsHitTestVisible="False" />
                        <!-- 左上亮高光 -->
                        <Border
                            Margin="-2,-3,2,3"
                            Background="{ThemeResource LomaShadowLight}"
                            CornerRadius="{StaticResource LomaCardRadius}"
                            IsHitTestVisible="False" />
                        <!-- 卡面 -->
                        <Border
                            Background="{ThemeResource LomaCardFace}"
                            CornerRadius="{StaticResource LomaCardRadius}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      LomaSunken：凹陷井口。属性面板的字段区。

      与 LomaRaised 方向相反——顶部压暗、底部受光，一眼看出是"凹进去"的。
      模拟在软泥上按出一个坑：坑的内壁上方是阴影，下方反出一点光。
    -->
    <Style x:Key="LomaWell" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border
                            Background="{ThemeResource LomaWellFace}"
                            CornerRadius="{StaticResource LomaWellRadius}">
                            <Grid>
                                <!-- 井口顶部内阴影：上深下无。
                                     贴齐井口自己的圆角（Margin 不再留 2px），
                                     否则井口边缘会露出一条底色细缝，
                                     看着像框外又描了一道线。
                                     高度必须 ≥ 圆角半径：8px 高的带子套 6 的
                                     圆角，弧线占位不超过 6px，填充完整可见。 -->
                                <Border
                                    Height="8"
                                    VerticalAlignment="Top"
                                    CornerRadius="6,6,0,0"
                                    Background="{ThemeResource LomaWellShade}"
                                    IsHitTestVisible="False" />
                                <!-- 井口底部反弹光：下亮上无，渐亮而非一块亮片 -->
                                <Border
                                    Height="8"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="0,0,6,6"
                                    Background="{ThemeResource LomaWellLip}"
                                    IsHitTestVisible="False" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      LomaButton：标准按钮——一块凸起的软泥块。

      三态靠阴影方向和底色深浅表达，不靠边框：
        · Normal   ：凸起，右下暗投影 + 左上亮高光
        · PointerOver：高光加强，略亮
        · Pressed  ：反转阴影方向（暗投影移到左上、高光移到右下），
                     同时底色压暗——视觉上像被按进了桌面
        · Disabled ：所有阴影消失，平放在桌面上

      这个模板完整重画了按钮的视觉，不依赖框架默认的 BorderBrush。
    -->
    <Style x:Key="LomaButton" TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="{StaticResource LomaPadButton}" />
        <Setter Property="CornerRadius" Value="{StaticResource LomaButtonRadius}" />
        <Setter Property="Background" Value="{ThemeResource LomaRaised}" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInk}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 右下暗投影（凸起时可见，按下时隐藏） -->
                        <Border
                            x:Name="ShadowDark"
                            Margin="2,3,-2,-3"
                            Background="{ThemeResource LomaShadowDarkDeep}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShadowDarkXform" />
                            </Border.RenderTransform>
                        </Border>
                        <!-- 左上亮高光（凸起时可见，按下时隐藏） -->
                        <Border
                            x:Name="ShadowLight"
                            Margin="-2,-3,2,3"
                            Background="{ThemeResource LomaShadowLight}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShadowLightXform" />
                            </Border.RenderTransform>
                        </Border>
                        <!-- 按下时的反向投影（左上暗） -->
                        <Border
                            x:Name="ShadowDarkInset"
                            Margin="-2,-3,2,3"
                            Background="{ThemeResource LomaShadowDarkDeep}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <!-- 按下时的反向高光（右下亮） -->
                        <Border
                            x:Name="ShadowLightInset"
                            Margin="2,3,-2,-3"
                            Background="{ThemeResource LomaShadowLight}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <!-- 按钮面 -->
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="Content"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ContentXform" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaRaised}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaInk}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ShadowDark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContentXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaRaisedTop}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaAccent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ShadowDark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <!-- 悬停浮起：阴影离得更远、高光升得更高 -->
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkXform" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightXform" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaSunken}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaAccentPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!-- 凸起阴影消失，凹陷阴影出现 -->
                                        <DoubleAnimation Storyboard.TargetName="ShadowDark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkInset" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightInset" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <!-- 按下：内容下压 1px，阴影收回原位 -->
                                        <DoubleAnimation Storyboard.TargetName="ContentXform" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaInkTertiary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ShadowDark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightInset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowDarkXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowLightXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="ContentXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      LomaIconButton：工具栏图标按钮。平时是"看不见的一块"，
      悬停才微微浮起一层，按下时凹陷。和 LomaButton 同语言，只是没有文字。
    -->
    <Style x:Key="LomaIconButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInkSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="RootXform" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaInkSecondary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="RootXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaRaised}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaInk}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!-- 悬停：整块上浮 1px -->
                                        <DoubleAnimation Storyboard.TargetName="RootXform" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaSunken}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaAccentPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!-- 按下：整块下沉 1px -->
                                        <DoubleAnimation Storyboard.TargetName="RootXform" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LomaInkTertiary}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="RootXform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Content"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      隐式 TextBox 样式（无 x:Key，应用到所有输入框）：
        · 未聚焦：凹陷坑 + 一圈可见的发丝边（LomaFieldEdge），保证用户一眼能找到；
        · 悬停：坑略加深；
        · 聚焦：不画 accent 环——凹坑抬起、底色由凹陷转凸起，
          边线仍是那根中性发丝边（聚焦是"这块地被拿起来"，不是"套上光晕"）；
        · 禁用：平贴、弱化。
      所有过渡都用 Opacity/Background 平滑交叉，不生硬跳变。
    -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- 凹陷内阴影：上沿压暗，给出"坑"的深度 -->
                        <Border
                            x:Name="InsetShadow"
                            Margin="0,2,0,-2"
                            Background="{ThemeResource LomaShadowDark}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <!-- 凹陷面 -->
                        <Border
                            x:Name="BackgroundElement"
                            Background="{ThemeResource TextControlBackground}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid Padding="{TemplateBinding Padding}">
                                <!-- 内容层：滚动条一律隐藏。
                                     光标（caret）比正文高一两像素，滚动条因此会被
                                     判定为"可滚动"；它一出现，24px 的期望高度
                                     就会把 ScrollViewer 撑大，输入框跟着长高
                                     （鼠标一悬停、光标一亮就"涨"一下）。
                                     隐藏后 ScrollViewer 尺寸稳定，滚动仍可用。 -->
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    VerticalScrollBarVisibility="Hidden"
                                    HorizontalScrollBarVisibility="Hidden" />
                                <ContentPresenter
                                    x:Name="PlaceholderTextContentPresenter"
                                    Content="{TemplateBinding PlaceholderText}"
                                    Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                    IsHitTestVisible="False"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- 发丝边：聚焦时也留着，且始终是中性色。
                             焦点提示不靠 accent 环，靠底色与坑深的变化。 -->
                        <Border
                            x:Name="EdgeElement"
                            Background="Transparent"
                            BorderBrush="{ThemeResource LomaFieldEdge}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundElement" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundElement" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetName="InsetShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundElement" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="EdgeElement" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FocusStates">
                                <!-- 未聚焦：不写故事板。基值即未聚焦外观
                                     （EdgeElement Opacity=1、InsetShadow Opacity=1）。
                                     离开 Focused 时框架撤掉聚焦动画，自动回到这些基值。 -->
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <!-- 聚焦不画任何 accent 环，只把坑抬起来：上沿压暗松开，像从井里抬起 -->
                                        <DoubleAnimation Storyboard.TargetName="InsetShadow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundElement" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundFocused}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      隐式 ToolTip：悬浮快捷键提示。
      只覆写颜色/圆角/内边距，不换 ControlTemplate——保留框架默认的
      锚定定位与自动消失逻辑。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource LomaRaised}" />
        <Setter Property="Foreground" Value="{ThemeResource LomaInk}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource LomaFontSizeCaption}" />
    </Style>

    <!-- ═══════════ 列表行模板 ═══════════ -->

    <!--
      节点行：左侧一道"书脊"色条（入口节点为 accent），像案头立着的索引卡。
      选中行整体染上 accent 淡色。
    -->
    <DataTemplate x:Key="LomaNodeRow">
        <Grid ColumnSpacing="{StaticResource LomaSpaceM}" Padding="{StaticResource LomaPadRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="4"
                Height="20"
                CornerRadius="2"
                Background="{Binding SpineBrush}" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding Id}"
                FontSize="{StaticResource LomaFontSizeBody}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                Text="{Binding CountText}"
                FontSize="{StaticResource LomaFontSizeCaption}"
                Foreground="{ThemeResource LomaInkTertiary}"
                VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!--
      指令行：语义色徽章 + 摘要。徽章是一块微凸的小方块。
    -->
    <DataTemplate x:Key="LomaInstructionRow">
        <Grid ColumnSpacing="10" Padding="{StaticResource LomaPadRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="{StaticResource LomaBadgeSize}"
                Height="{StaticResource LomaBadgeSize}"
                CornerRadius="{StaticResource LomaBadgeRadius}"
                Background="{Binding KindBrush}">
                <TextBlock
                    Text="{Binding KindGlyph}"
                    FontSize="{StaticResource LomaFontSizeBadge}"
                    Foreground="{ThemeResource LomaBadgeInk}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding SummaryText}"
                    FontSize="{StaticResource LomaFontSizeBody}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{Binding KindLabel}"
                    FontSize="{StaticResource LomaFontSizeCaption}"
                    Foreground="{ThemeResource LomaInkTertiary}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>

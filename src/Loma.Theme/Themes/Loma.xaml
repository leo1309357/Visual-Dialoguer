<?xml version="1.0" encoding="utf-8"?>
<!--
  「Loma」— VisualDialoguer 轻拟物（Soft Neumorphism）主题。

  设计立意：把编辑器变成一块温润的实体材质——所有控件从同一块"面团"里
  挤压出来，不靠描边、不靠对比色，只靠左上受光 + 右下投影的双向阴影
  表达凹凸。整体氛围安静、柔软、专注，像用手指在一块暖灰色软泥上
  按压出按钮和凹槽。

  与 Paperstage 的区别：
  · Paperstage 是"纸叠"——纸片之间靠明度差 + 发丝边分层；
  · Loma 是"泥塑"——物体与背景几乎同色，靠双向阴影的方向与深浅表达
    凸起 / 凹陷 / 按下 / 浮起，没有描边线。

  实现要点：
  1. 覆写全部框架语义键（Button* / TextControl* / ListViewItem* 等），
     原生控件自动跟着 Loma 调色板走；
  2. 自定义 LomaRaised / LomaSunken / LomaButton / LomaIconButton
     四个模板，用"双层偏移 Border"模拟软阴影，无需任何第三方库；
  3. 双主题（Light / Dark）共用同一套视觉语汇，只是明暗反转。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════ 日间 Light ═══════════════ -->
        <ResourceDictionary x:Key="Light">

            <!-- ── 材质底色：所有凹凸都从这块"面团"上长出来 ── -->
            <!-- 桌面底色：暖灰，像一块磨砂石材台面 -->
            <Color x:Key="LomaBaseColor">#DCD6D0</Color>
            <!-- 凸起面：比底色亮一档，配合左上高光形成"浮起"感 -->
            <Color x:Key="LomaRaisedColor">#EFEAE5</Color>
            <!-- 凸起面顶部受光极限：纯白高光的最亮处 -->
            <Color x:Key="LomaRaisedTopColor">#F8F5F1</Color>
            <!-- 凸条（工具栏/状态栏）专用面：上缘受光，下缘转向背光 -->
            <Color x:Key="LomaBarTopColor">#F6F2ED</Color>
            <Color x:Key="LomaBarBottomColor">#E9E4DE</Color>
            <!-- 凸条上棱：受光的那一条亮边 -->
            <Color x:Key="LomaBarRimColor">#FCFAF8</Color>
            <!-- 凹陷面：比底色暗，配合内阴影形成"压下去"感 -->
            <Color x:Key="LomaSunkenColor">#C8C2BA</Color>
            <!-- 凹陷面底部：最暗处 -->
            <Color x:Key="LomaSunkenDeepColor">#BFB9B1</Color>

            <!-- ── 双向阴影色 ── -->
            <!-- 暗部投影：暖灰，半透明，右下方向 -->
            <Color x:Key="LomaShadowDarkColor">#3D3528</Color>
            <!-- 暗部投影透明度：关键参数，越大越"厚" -->
            <Color x:Key="LomaShadowDarkSoftColor">#223D3528</Color>
            <Color x:Key="LomaShadowDarkDeepColor">#403D3528</Color>
            <!-- 亮部高光：纯白，左上方向 -->
            <Color x:Key="LomaShadowLightColor">#CCFFFFFF</Color>
            <Color x:Key="LomaShadowLightSoftColor">#80FFFFFF</Color>
            <!-- 环境影：更淡更大的一层，让卡片真正离开桌面 -->
            <Color x:Key="LomaShadowAmbientColor">#0E3D3528</Color>

            <!-- 发丝边：Loma 原则上不用边框，但流程图代码和标题栏需要一个值 -->
            <Color x:Key="LomaEdgeColor">#CFC9C0</Color>
            <Color x:Key="LomaEdgeStrongColor">#B5AFA6</Color>
            <!-- 输入框未聚焦时的可见边：比凹陷面略深，保证用户能找到输入框 -->
            <Color x:Key="LomaFieldEdgeColor">#B2ABA2</Color>

            <!-- ── 文字三级（暖墨色，不用纯黑）── -->
            <Color x:Key="LomaInkColor">#3F3A35</Color>
            <Color x:Key="LomaInkSecondaryColor">#6B645B</Color>
            <Color x:Key="LomaInkTertiaryColor">#948D82</Color>

            <!-- ── 签名色：鼠尾草绿（安静、专注、温润）── -->
            <!-- 主色：低饱和鼠尾草，用于主操作、选中态、聚焦框 -->
            <Color x:Key="LomaAccentColor">#6E8F82</Color>
            <Color x:Key="LomaAccentHoverColor">#82A395</Color>
            <Color x:Key="LomaAccentPressedColor">#5C7D70</Color>
            <!-- 淡染：选中行、悬停层的底色 -->
            <Color x:Key="LomaAccentWashColor">#1F6E8F82</Color>
            <Color x:Key="LomaAccentEdgeColor">#4D6E8F82</Color>
            <!-- 压在实底 accent 上的字 -->
            <Color x:Key="LomaOnAccentColor">#F5F2EE</Color>

            <!-- ── 交互态填充 ── -->
            <!-- 悬停：比凸起面略亮一点，没有对比色跳跃 -->
            <Color x:Key="LomaHoverColor">#F0EDE8</Color>
            <!-- 按下：压进凹陷面 -->
            <Color x:Key="LomaPressedColor">#CFCAC2</Color>
            <!-- 禁用：平放在底色上，推不动 -->
            <Color x:Key="LomaDisabledColor">#DCD8D2</Color>
            <!-- 遮罩：暖黑 -->
            <Color x:Key="LomaScrimColor">#4D2A241E</Color>

            <!-- ── 流程图画布 ── -->
            <Color x:Key="LomaGraphDeskColor">#E0DCD6</Color>
            <Color x:Key="LomaGraphGridColor">#147A7268</Color>
            <Color x:Key="LomaThreadColor">#8A8378</Color>

            <!-- ── 8 种指令语义色（与 Paperstage 同源，但统一压柔半档）── -->
            <Color x:Key="LomaKindSpeakerColor">#5A8AA0</Color>
            <Color x:Key="LomaKindLineColor">#8478A8</Color>
            <Color x:Key="LomaKindChoiceColor">#B5705A</Color>
            <Color x:Key="LomaKindGotoColor">#A08040</Color>
            <Color x:Key="LomaKindSetColor">#6A9070</Color>
            <Color x:Key="LomaKindClearColor">#807868</Color>
            <Color x:Key="LomaKindEmitColor">#A86890</Color>
            <Color x:Key="LomaKindEndColor">#605A54</Color>
            <Color x:Key="LomaBadgeInkColor">#F5F2EE</Color>

            <!-- ═══════════════ 画刷令牌 ═══════════════ -->
            <SolidColorBrush x:Key="LomaBase" Color="{StaticResource LomaBaseColor}" />
            <SolidColorBrush x:Key="LomaRaised" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="LomaRaisedTop" Color="{StaticResource LomaRaisedTopColor}" />
            <SolidColorBrush x:Key="LomaSunken" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="LomaSunkenDeep" Color="{StaticResource LomaSunkenDeepColor}" />

            <SolidColorBrush x:Key="LomaShadowDark" Color="{StaticResource LomaShadowDarkSoftColor}" />
            <SolidColorBrush x:Key="LomaShadowDarkDeep" Color="{StaticResource LomaShadowDarkDeepColor}" />
            <SolidColorBrush x:Key="LomaShadowLight" Color="{StaticResource LomaShadowLightSoftColor}" />
            <SolidColorBrush x:Key="LomaShadowAmbient" Color="{StaticResource LomaShadowAmbientColor}" />

            <!-- 凸条投在桌面上的影：贴条的那一端最深，向外迅速淡出。
                 只能画在条的"外面"——画在条内侧就会变成一条悬空的硬缝，
                 凸条立刻塌成一张贴纸。 -->
            <LinearGradientBrush x:Key="LomaEdgeShadowDown" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3B3D3528" Offset="0" />
                <GradientStop Color="#1E3D3528" Offset="0.35" />
                <GradientStop Color="#003D3528" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LomaEdgeShadowUp" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#003D3528" Offset="0" />
                <GradientStop Color="#1E3D3528" Offset="0.65" />
                <GradientStop Color="#3B3D3528" Offset="1" />
            </LinearGradientBrush>

            <!-- ── 凸条（工具栏 / 状态栏）的立体构造 ──
                 和卡片同一套光影：光源在左上，条面顶亮底暗。
                 渐变刻意在顶部 15% 内跑完大半落差——那一段对应条子的圆角
                 上缘受光，跑得慢就成了一片线性色带，看着还是贴纸。
                 下半段只留很轻的压暗，交代条面朝下转折。
                 投影必须画在条"外面"：贴条那端最深，向外淡出。 -->
            <LinearGradientBrush x:Key="LomaBarFace" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource LomaBarTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource LomaRaisedColor}" Offset="0.15" />
                <GradientStop Color="{StaticResource LomaRaisedColor}" Offset="0.72" />
                <GradientStop Color="{StaticResource LomaBarBottomColor}" Offset="1" />
            </LinearGradientBrush>
            <!-- 上棱：一像素亮线，交代光源来自左上 -->
            <SolidColorBrush x:Key="LomaBarRim" Color="{StaticResource LomaBarRimColor}" />

            <SolidColorBrush x:Key="LomaEdge" Color="{StaticResource LomaEdgeColor}" />
            <SolidColorBrush x:Key="LomaEdgeStrong" Color="{StaticResource LomaEdgeStrongColor}" />

            <SolidColorBrush x:Key="LomaInk" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="LomaInkSecondary" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="LomaInkTertiary" Color="{StaticResource LomaInkTertiaryColor}" />

            <SolidColorBrush x:Key="LomaAccent" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="LomaAccentHover" Color="{StaticResource LomaAccentHoverColor}" />
            <SolidColorBrush x:Key="LomaAccentPressed" Color="{StaticResource LomaAccentPressedColor}" />
            <SolidColorBrush x:Key="LomaAccentWash" Color="{StaticResource LomaAccentWashColor}" />
            <SolidColorBrush x:Key="LomaAccentEdge" Color="{StaticResource LomaAccentEdgeColor}" />
            <SolidColorBrush x:Key="LomaOnAccent" Color="{StaticResource LomaOnAccentColor}" />

            <SolidColorBrush x:Key="LomaHover" Color="{StaticResource LomaHoverColor}" />
            <SolidColorBrush x:Key="LomaPressed" Color="{StaticResource LomaPressedColor}" />
            <SolidColorBrush x:Key="LomaDisabled" Color="{StaticResource LomaDisabledColor}" />
            <SolidColorBrush x:Key="LomaScrim" Color="{StaticResource LomaScrimColor}" />

            <SolidColorBrush x:Key="LomaGraphDesk" Color="{StaticResource LomaGraphDeskColor}" />
            <SolidColorBrush x:Key="LomaGraphGrid" Color="{StaticResource LomaGraphGridColor}" />
            <SolidColorBrush x:Key="LomaThread" Color="{StaticResource LomaThreadColor}" />

            <SolidColorBrush x:Key="LomaKindSpeaker" Color="{StaticResource LomaKindSpeakerColor}" />
            <SolidColorBrush x:Key="LomaKindLine" Color="{StaticResource LomaKindLineColor}" />
            <SolidColorBrush x:Key="LomaKindChoice" Color="{StaticResource LomaKindChoiceColor}" />
            <SolidColorBrush x:Key="LomaKindGoto" Color="{StaticResource LomaKindGotoColor}" />
            <SolidColorBrush x:Key="LomaKindSet" Color="{StaticResource LomaKindSetColor}" />
            <SolidColorBrush x:Key="LomaKindClear" Color="{StaticResource LomaKindClearColor}" />
            <SolidColorBrush x:Key="LomaKindEmit" Color="{StaticResource LomaKindEmitColor}" />
            <SolidColorBrush x:Key="LomaKindEnd" Color="{StaticResource LomaKindEndColor}" />
            <SolidColorBrush x:Key="LomaBadgeInk" Color="{StaticResource LomaBadgeInkColor}" />

            <!-- ── 卡面渐变：顶部受光 → 底色，模拟材质顶部的光反射 ── -->
            <LinearGradientBrush x:Key="LomaCardFace" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource LomaRaisedTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource LomaRaisedColor}" Offset="0.6" />
                <GradientStop Color="{StaticResource LomaBaseColor}" Offset="1" />
            </LinearGradientBrush>

            <!-- ── 凹陷面：**整块平色**，就取桌面底色。
                 以前这里是 深凹→浅凹→底色 的整幅竖向渐变，问题在于这条渐变
                 会横穿输入框自己的面色（LomaSunkenColor）：
                 井口上半段比框面深、下半段比框面浅，于是同一个输入框
                 在上沿显得"凸起"、在下沿显得"凹陷"——一条边界两种语义，
                 这就是"输入框和背景容器边界不自然"的根源。
                 凹槽的深度改由上下两条窄带（顶影 / 底反光）交代，
                 这也正是轻拟物凹陷的标准做法：面不变，只靠壁上的光影。 -->
            <SolidColorBrush x:Key="LomaWellFace" Color="{StaticResource LomaBaseColor}" />

            <!-- ── 凹陷顶部内阴影：上深下无，让井口边缘暗下去。
                 结束色必须是**自身颜色的全透明版**（#00RRGGBB）。
                 这里原本写的是 #00FFFFFF（透明白），而 WinUI 的渐变按非预乘
                 方式插值：中段颜色会一路朝白色漂，于是顶影淡出处浮出一圈
                 **亮的** 白边。深色主题下尤其刺眼——黑边下面紧接一条亮带，
                 整个井口看着像用马克笔描了两道线。 ── -->
            <LinearGradientBrush x:Key="LomaWellShade" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource LomaShadowDarkDeepColor}" Offset="0" />
                <GradientStop Color="#003D3528" Offset="1" />
            </LinearGradientBrush>

            <!-- ── 井口底缘的反弹光：往下渐亮，最亮处在井口的近底边上。
                 两端都是白色，所以这里用 #00FFFFFF 当透明端是安全的
                 （会漂色的只有"深色 → 透明白"这种跨色相的渐变）。 ── -->
            <LinearGradientBrush x:Key="LomaWellLip" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="{StaticResource LomaShadowLightColor}" Offset="1" />
            </LinearGradientBrush>

            <!-- ═══════════════ 框架语义键覆写 ═══════════════ -->

            <!-- 按钮：凸起 → 悬停更亮 → 按下凹陷 -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource LomaRaisedTopColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource LomaDisabledColor}" />
            <!-- Loma 不靠描边分边界，按钮无边框，阴影自己说话 -->
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource LomaAccentEdgeColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource LomaInkTertiaryColor}" />

            <!-- 文本框：下沉井口，聚焦时浮起一圈 accent 色 -->
            <CornerRadius x:Key="TextControlCornerRadius">6</CornerRadius>
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource LomaSunkenDeepColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            <!-- 输入框未聚焦发丝边（自定义模板用） -->
            <SolidColorBrush x:Key="LomaFieldEdge" Color="{StaticResource LomaFieldEdgeColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource LomaInkTertiaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource LomaInkTertiaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource LomaInkSecondaryColor}" />

            <!-- 下拉框 -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource LomaSunkenDeepColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource LomaAccentEdgeColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource LomaFieldEdgeColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource LomaHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource LomaAccentWashColor}" />

            <!-- 列表项：悬停是微亮层，选中是淡染 accent -->
            <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource LomaHoverColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{StaticResource LomaPressedColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource LomaAccentWashColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource LomaAccentWashColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource LomaAccentWashColor}" />
            <SolidColorBrush x:Key="ListViewItemRevealBorderBrush" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />

            <!-- 命令栏按钮：平时透明，悬停浮出一层 -->
            <SolidColorBrush x:Key="AppBarButtonBackground" Color="#00000000" />
            <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="{StaticResource LomaAccentWashColor}" />
            <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="AppBarButtonForeground" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="{StaticResource LomaAccentPressedColor}" />

            <!-- 通用填充与文字令牌 -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource LomaInkSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource LomaInkTertiaryColor}" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource LomaInkTertiaryColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource LomaSunkenColor}" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource LomaDisabledColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LomaBaseColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />

            <!-- 焦点框：鼠尾草绿 -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource LomaRaisedTopColor}" />
            <SolidColorBrush x:Key="SystemAccentColorLight1" Color="{StaticResource LomaAccentHoverColor}" />

            <!-- 主操作按钮（AccentButtonStyle）：实底鼠尾草 -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource LomaAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource LomaAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource LomaAccentPressedColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource LomaOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource LomaOnAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource LomaOnAccentColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource LomaOnAccentColor}" />

            <!-- 提示气泡：浮起的小块 -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource LomaInkColor}" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="Transparent" />

            <!-- 对话框 -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource LomaRaisedColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{StaticResource LomaShadowDarkSoftColor}" />

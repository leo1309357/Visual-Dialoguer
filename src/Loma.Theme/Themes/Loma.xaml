            <Color x:Key="LomaAccentHoverColor">#A5C8B8</Color>
            <Color x:Key="LomaAccentPressedColor">#7BA896</Color>
            <Color x:Key="LomaAccentWashColor">#268FB8A8</Color>
            <Color x:Key="LomaAccentEdgeColor">#598FB8A8</Color>
            <Color x:Key="LomaOnAccentColor">#1E1C1A</Color>

            <!-- 交互态 -->

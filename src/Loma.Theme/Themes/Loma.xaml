            <Color x:Key="LomaKindLineColor">#AC9AD6</Color>
            <Color x:Key="LomaKindChoiceColor">#D49080</Color>
            <Color x:Key="LomaKindGotoColor">#DFB068</Color>
            <Color x:Key="LomaKindSetColor">#82B890</Color>

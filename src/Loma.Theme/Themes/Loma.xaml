            <Color x:Key="LomaBarBottomColor">#2D2A28</Color>
            <!-- 凸条上棱：暗底上的受光亮边 -->
            <Color x:Key="LomaBarRimColor">#4C4946</Color>
            <Color x:Key="LomaSunkenColor">#1A1816</Color>
            <Color x:Key="LomaSunkenDeepColor">#141210</Color>

            <!-- 双向阴影：暗底上高光变弱、投影变黑 -->

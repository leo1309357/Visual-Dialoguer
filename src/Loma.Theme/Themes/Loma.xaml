            <Color x:Key="LomaShadowLightColor">#14FFFFFF</Color>
            <Color x:Key="LomaShadowLightSoftColor">#18FFFFFF</Color>
            <Color x:Key="LomaShadowAmbientColor">#24000000</Color>

